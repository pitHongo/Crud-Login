# ==============================
# BACKEND (Python / Django)
# ==============================
# Archivos de caché de Python (las carpetas que preguntaste)
__pycache__/
*.py[cod]
*$py.class

# Entornos virtuales (donde se instalan las librerías)
venv/
.venv/
env/
ENV/
backend/venv/

# Base de datos local (nunca se sube la data real al repositorio)
*.sqlite3
db.sqlite3
backend/db.sqlite3

# Archivos de entorno y secretos
.env
.env.local

# ==============================
# FRONTEND (Node / React / Vite)
# ==============================
# Dependencias pesadas
node_modules/
frontend/node_modules/

# Builds y compilados (lo que se genera para producción)
dist/
build/
frontend/dist/

# Logs de errores de Node
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==============================
# ARCHIVOS DEL SISTEMA / EDITOR
# ==============================
# VS Code
.vscode/
*.code-workspace

# Windows / Mac
Thumbs.db
.DS_Store
